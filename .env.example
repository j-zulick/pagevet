# PageVet settings. Copy to .env (never commit it) or export them. A variable already set in the
# environment wins over .env. Plain HTTP scanning needs none of these.

# Firecrawl, for --via firecrawl (rendered HTML)
PAGEVET_FIRECRAWL_URL=
PAGEVET_FIRECRAWL_KEY=

# crawlee-server, for --crawl
PAGEVET_CRAWL_URL=
PAGEVET_CRAWL_TOKEN=

# SearXNG, for pagevet-discover (an instance with the JSON format enabled; the token only if it needs one)
PAGEVET_SEARXNG_URL=
PAGEVET_SEARXNG_TOKEN=

# Llama Prompt Guard 2, for --second-opinion promptguard (pip install "pagevet[classifier]").
# The model is gated: accept its license on Hugging Face, then set a read token.
HF_TOKEN=
PAGEVET_PROMPTGUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
PAGEVET_PROTECTAI_MODEL=

# OpenRouter: --second-opinion jev (Jev through the Decisions API) and --second-opinion llm. Billed per call.
OPENROUTER_API_KEY=
# Jev model on OpenRouter (empty = ~typesafe/jev-latest)
PAGEVET_JEV_MODEL=
# --second-opinion llm: an OpenRouter model id, maker/model (no default: model names go stale)
PAGEVET_LLM_MODEL=

# Jev through the TypeSafe SDK instead, when OPENROUTER_API_KEY is empty (pip install "pagevet[jev]"); billed by TypeSafe.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=

# Langfuse, for --langfuse on pagevet and pagevet-bench (pip install "pagevet[langfuse]"); BASE_URL only when self-hosted
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Supabase, for integrations/supabase/load.py. Server-side only: the service-role key bypasses row level security.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hindsight agent memory, for integrations/hindsight/remember.py (the key only for Hindsight Cloud)
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK=

# Ollama (local, not billed): --second-opinion ollama and pagevet-replay.
OLLAMA_HOST=
PAGEVET_OLLAMA_MODEL=
