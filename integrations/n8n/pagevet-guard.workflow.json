{
  "name": "PageVet guard: clean a page before an AI step",
  "nodes": [
    {
      "parameters": {},
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": { "assignments": [ { "name": "url", "type": "string", "value": "https://example.com/" } ] }
      },
      "name": "Page URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PAGEVET_SERVE_URL || 'http://127.0.0.1:8790' }}/guard",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.url, policy: 'high' }) }}",
        "options": { "timeout": 60000 }
      },
      "name": "PageVet guard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [ { "leftValue": "={{ $json.allowed }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } } ],
          "combinator": "and"
        }
      },
      "name": "Allowed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "assignments": { "assignments": [ { "name": "text_for_model", "type": "string", "value": "={{ $json.text }}" } ] }
      },
      "name": "Text for the AI step",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, -80]
    },
    {
      "parameters": {
        "assignments": { "assignments": [ { "name": "blocked_findings", "type": "array", "value": "={{ $json.findings }}" } ] }
      },
      "name": "Blocked: review findings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, 80]
    }
  ],
  "connections": {
    "Start": { "main": [[{ "node": "Page URL", "type": "main", "index": 0 }]] },
    "Page URL": { "main": [[{ "node": "PageVet guard", "type": "main", "index": 0 }]] },
    "PageVet guard": { "main": [[{ "node": "Allowed?", "type": "main", "index": 0 }]] },
    "Allowed?": {
      "main": [
        [{ "node": "Text for the AI step", "type": "main", "index": 0 }],
        [{ "node": "Blocked: review findings", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {}
}
